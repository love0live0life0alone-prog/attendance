# PostgreSQL connection string (Railway/Render/Supabase all give you one of these)
DATABASE_URL=postgres://user:password@host:5432/attendance

# Long random secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ADMIN_SECRET=change_me_admin_secret

PORT=3000
